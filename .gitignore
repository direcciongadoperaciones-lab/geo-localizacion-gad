* {
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
  margin: 0;
  font-family: Inter, Arial, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
  padding: 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  padding: 18px 22px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.7);
  backdrop-filter: blur(10px);
}

.eyebrow {
  margin: 0 0 8px;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 11px;
}

h1, h2, h3, h4, p {
  margin-top: 0;
}

h1 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.5rem);
}

.session-info {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #dbeafe;
}

.ghost-button,
.action-button,
.primary-full {
  border: none;
  border-radius: 10px;
  padding: 0.8rem 1rem;
  font-weight: 700;
  transition: transform 0.2s ease;
}

.ghost-button:hover,
.action-button:hover,
.primary-full:hover {
  transform: translateY(-1px);
}

.primary-full {
  width: 100%;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  color: white;
}

.action-button {
  padding: 0.8rem 1.2rem;
  background: #2563eb;
  color: white;
}

.action-button.secondary {
  background: #1f2937;
}

.action-button.disabled {
  background: #334155;
  opacity: 0.7;
}

.notification-banner {
  margin-bottom: 20px;
  background: rgba(34, 197, 94, 0.15);
  color: #d9f99d;
  border: 1px solid rgba(34, 197, 94, 0.35);
  border-radius: 12px;
  padding: 0.85rem 1rem;
}

.login-shell {
  min-height: 70vh;
  display: grid;
  place-items: center;
}

.login-card,
.panel {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.35);
}

.login-card {
  width: min(100%, 440px);
}

.login-form {
  display: grid;
  gap: 14px;
}

.login-form input,
.form-card input,
.form-card textarea,
.message-box input,
.form-card label input,
.form-card label textarea {
  width: 100%;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  padding: 0.8rem 0.9rem;
  background: rgba(15, 23, 42, 0.65);
  color: white;
}

.login-form input::placeholder,
.form-card input::placeholder,
.form-card textarea::placeholder,
.message-box input::placeholder {
  color: #94a3b8;
}

.error-message {
  color: #fca5a5;
  font-size: 0.9rem;
}

.demo-accounts {
  margin-top: 18px;
  display: grid;
  gap: 6px;
  color: #cbd5e1;
}

.content-grid {
  display: grid;
  gap: 24px;
}

.two-columns {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.full-width {
  grid-column: 1 / -1;
}

.admin-summary {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  background: rgba(30, 41, 59, 0.75);
  border-radius: 12px;
  padding: 12px 14px;
}

.form-card {
  display: grid;
  gap: 14px;
}

.form-card label {
  display: grid;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.72);
}

.status-green {
  border-color: rgba(34, 197, 94, 0.8) !important;
  box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.25);
}

.status-red {
  border-color: rgba(248, 113, 113, 0.7) !important;
  box-shadow: 0 0 0 1px rgba(248, 113, 113, 0.2);
}

.required-indicator {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.status-chip {
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.status-chip.status-green {
  background: rgba(34, 197, 94, 0.12);
  color: #bbf7d0;
}

.status-chip.status-red {
  background: rgba(239, 68, 68, 0.12);
  color: #fecaca;
}

.tracking-box {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 14px;
  padding: 16px;
}

.duration-select {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0;
}

.time-pill {
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 999px;
  color: white;
  padding: 0.55rem 0.8rem;
}

.time-pill.selected {
  background: linear-gradient(90deg, #10b981, #059669);
  border-color: transparent;
}

.tracking-actions {
  display: flex;
  gap: 10px;
}

.tracker-state {
  display: grid;
  gap: 4px;
  margin-top: 12px;
  color: #dbeafe;
}

.contact-buttons {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}

.contact-buttons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: white;
  background: linear-gradient(90deg, #06b6d4, #0284c7);
  text-decoration: none;
  border-radius: 10px;
  padding: 0.8rem 1rem;
  font-weight: 700;
}

.map-wrap {
  width: 100%;
  min-height: 420px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.map-root {
  width: 100%;
  height: 420px;
}

.admin-list {
  display: grid;
  gap: 12px;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 12px 14px;
  background: rgba(15, 23, 42, 0.72);
}

.status-pill {
  padding: 0.45rem 0.7rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
}

.status-pill.active {
  background: rgba(34, 197, 94, 0.12);
  color: #bbf7d0;
}

.status-pill.inactive {
  background: rgba(148, 163, 184, 0.12);
  color: #e2e8f0;
}

.message-box {
  display: flex;
  gap: 12px;
  align-items: center;
}

.message-list {
  display: grid;
  gap: 10px;
  margin-top: 8px;
}

.message-item {
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 12px 14px;
  background: rgba(15, 23, 42, 0.72);
}

.message-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 6px;
  font-size: 0.8rem;
  color: #cbd5e1;
}

.message-item p {
  margin: 0;
  color: #e2e8f0;
}

.compact input {
  margin-bottom: 10px;
}

@media (max-width: 900px) {
  .two-columns {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .message-box {
    flex-direction: column;
  }
}
